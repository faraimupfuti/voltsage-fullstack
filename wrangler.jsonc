{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name. It also sets the default URL: https://voltsage.<your-subdomain>.workers.dev
  "name": "voltsage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "voltsage" }],
  "observability": { "enabled": true }

  // Custom domain: add voltsage.co to your Cloudflare account first, then uncomment.
  // ,"routes": [
  //   { "pattern": "voltsage.co", "custom_domain": true },
  //   { "pattern": "www.voltsage.co", "custom_domain": true }
  // ]
}
